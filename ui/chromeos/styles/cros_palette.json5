/*
 * KibaOS color palette.
 *
 * All colors used in KibaOS WebUIs and System Web Apps should be specified
 * here. The ramps are named after the KibaOS design system hues; the blue ramp
 * is the seed used by the semantic tokens in cros_ref_colors.json5.
 */
{
  options: {
    proto: {
      field_name: 'palette_colors',
      field_id: 1,
    },
    ColorMappings: {
      set_name: 'LegacySemantic'
    },
  },
  colors: {
    kiba_blue_50: "#ecf3fe",
    kiba_blue_100: "#d6e7fd",
