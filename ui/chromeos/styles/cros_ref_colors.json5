    neutral60: '#7e8da8',
    neutral70: '#9dabc2',
    neutral80: '#bcc8da',
    neutral90: '#dae2ee',
    neutral95: '#edf2f9',
    neutral99: '#fbfcff',
    neutral100: '#ffffff',

    neutralvariant0: '#000000',
    neutralvariant10: '#141a24',
    neutralvariant20: '#232b39',
    neutralvariant30: '#37404f',
    neutralvariant40: '#4e5868',
    neutralvariant50: '#66717f',
