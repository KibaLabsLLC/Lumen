/*
 * cros.ref Color Tokens
 *
 * Base semantic palette for KibaOS. Most colors used in Ash and Aura should
 * resolve to these tokens.
 *
 * The ramps below are the KibaOS design system palette: a single royal-blue
 * seed (Kiba Blue), cool navy-tinted neutrals drawn from the KibaOS spec sheet
 * and a teal tertiary accent. These tokens are dynamically updated when the
 * theme changes.
 */
{
  token_namespace: 'cros.ref',
  options: {
    ColorMappings: {
      set_name: 'CrosRef',
    },
    proto: {
      field_name: 'palette_colors',
      field_id: 1,
    },
  },
  colors: {
    /* Kiba Blue: the single seed color of the KibaOS design system. */
    primary0: '#000000',
    primary10: '#041a3d',
    primary20: '#07285c',
    primary30: '#0a3d84',
    primary40: '#0d5bd4',
    primary50: '#1a6bf0',
    primary60: '#4a8bf7',
    primary70: '#7caff9',
    primary80: '#b0d3fb',
    primary90: '#d6e7fd',
    primary95: '#ecf3fe',
    primary99: '#fafcff',
    primary100: '#ffffff',

    /* Navy secondary: the dark swatches of the KibaOS color palette. */
    secondary0: '#000000',
    secondary10: '#0b1424',
    secondary12: '#0e1830',
    secondary15: '#121e3a',
    secondary20: '#182747',
    secondary30: '#24365c',
    secondary40: '#33486f',
    secondary50: '#4a6188',
    secondary60: '#6679a0',
    secondary70: '#8a9bbd',
    secondary80: '#b3c1da',
    secondary90: '#d9e3f3',
    secondary95: '#eef3fb',
    secondary99: '#fafcff',
    secondary100: '#ffffff',

    /* Teal tertiary: taken from the teal accent dot in the spec sheet. */
    tertiary0: '#000000',
    tertiary10: '#00201f',
    tertiary20: '#003733',
    tertiary30: '#00504a',
    tertiary40: '#0a6b62',
    tertiary50: '#12857a',
    tertiary60: '#26a094',
    tertiary70: '#4dbfb2',
    tertiary80: '#7edbd0',
    tertiary90: '#b3f0e8',
    tertiary95: '#dcfaf5',
    tertiary99: '#f5fffd',
    tertiary100: '#ffffff',

    error0: '#000000',
    error10: '#410e0b',
    error20: '#601410',
    error30: '#8c1d18',
    error40: '#b3261e',
    error50: '#dc362e',
    error60: '#e46962',
    error70: '#ec928e',
    error80: '#f2b8b5',
    error90: '#f9dedc',
    error95: '#fceeee',
    error99: '#fffbf9',
    error100: '#ffffff',

    /* Cool navy-grey neutrals, so every surface carries a blue cast. */
