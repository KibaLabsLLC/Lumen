/*
 * KibaOS elevation shadows.
 *
 * KibaOS uses two-part shadows (a tight key shadow plus a wide, low-alpha
 * ambient shadow) so floating surfaces read as glass above the blue canvas.
 */
 {
  options: {
    CSS: {
      prefix: 'cros'
    },
  },
  untyped_css: {
    /* TODO(calamity): Turn shadows into a first-class citizen of the generator */
    /* box-shadow values*/
    shadows: {
      elevation_1_shadow: '0 1px 2px var(--cros-shadow-color-key), 0 2px 8px var(--cros-shadow-color-ambient)',
      elevation_2_shadow: '0 1px 3px var(--cros-shadow-color-key), 0 4px 12px var(--cros-shadow-color-ambient)',
      elevation_3_shadow: '0 2px 4px var(--cros-shadow-color-key), 0 8px 20px var(--cros-shadow-color-ambient)',
      elevation_4_shadow: '0 4px 6px var(--cros-shadow-color-key), 0 12px 28px var(--cros-shadow-color-ambient)',
      elevation_5_shadow: '0 8px 12px var(--cros-shadow-color-key), 0 20px 40px var(--cros-shadow-color-ambient)',
    }
  }
 }
