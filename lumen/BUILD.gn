# KibaOS path and environment glue library.
source_set("kibaos_glue") {
  sources = [
    "kibaos_environment.cc",
    "kibaos_environment.h",
    "kibaos_paths.cc",
    "kibaos_paths.h",
    "kibaos_shell_glue.cc",
    "kibaos_shell_glue.h",
  ]
  deps = [
    ":lumen_shell_delegate",
    "//base",
    "//base:i18n",
    "//components/version_info",
  ]
}

# LumenShellDelegate as a standalone target so kibaos_glue can depend on it
# without a circular dep through the executable.
source_set("lumen_shell_delegate") {
  sources = [
    "lumen_shell_delegate.cc",
    "lumen_shell_delegate.h",
  ]
  deps = [
    "//ash",
    "//ash/public/cpp",
    "//base",
    "//chromeos/ash/components/audio",
    "//chromeos/ash/services/coral/public/mojom",
    "//chromeos/ash/services/nearby/public/mojom",
    "//components/account_id",
    "//components/user_education/common",
    "//mojo/public/cpp/bindings",
    "//services/metrics/public/cpp:metrics_cpp",
    "//ui/aura",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
    "//url",
  ]
}

# AshShellInit wires the KibaOS glue layer to ash::Shell. It is currently
# testonly because Lumen does not yet have a production compositor/display
# transport, so it reuses Ash/Chromium test support utilities for the
# in-process compositor and fake display delegate.
# TODO(b/123456789): Remove testonly once a production graphics transport is
# wired up.
source_set("ash_shell_init") {
  testonly = true
  sources = [
    "ash_shell_init.cc",
    "ash_shell_init.h",
  ]
  deps = [
    ":kibaos_glue",
    ":lumen_shell_delegate",
    "//ash",
    "//ash/keyboard/ui:test_support",
    "//base",
    "//ui/compositor:test_support",
    "//ui/display:test_support",
  ]
}

# The Lumen executable target. Marked testonly while AshShellInit depends on
# test compositor support.
# TODO(b/123456789): Remove testonly once a production graphics transport is
# wired up.
executable("chrome") {
  testonly = true
  sources = [ "main.cc" ]
  deps = [
    ":ash_shell_init",
    ":kibaos_glue",
    ":lumen_shell_delegate",
    "//base",
    "//components/version_info",
  ]
}
