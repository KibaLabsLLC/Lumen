import("//build/config/gclient_args.gni")
import("//build/config/python.gni")
import("//tools/json_to_struct/json_to_struct.gni")
import("//tools/metrics/histograms/histograms_xml_files.gni")

python_binary("generate_allowlist_from_histograms_file") {
  script = "histograms/generate_allowlist_from_histograms_file.py"
}

# Only include histograms_xml if we have access to dirmd data, which
# is used to populate ownership information.
# dirmd doesn't work in non-git checkout.
# TODO(crbug.com/329080012): Remove this once dirmd works in non-git
# checkouts.
if (path_exists("//.git")) {
  action("histograms_xml") {
    script = "histograms/merge_xml.py"
    output = "$root_out_dir/histograms.xml"
    outputs = [ output ]
    inputs = histograms_xml_files
    args = [
      "--output",
      rebase_path(output, root_build_dir),
    ]
  }
}

copy("actions_xml") {
  sources = [ "actions/actions.xml" ]
  outputs = [ "$root_out_dir/actions.xml" ]
}

copy("ukm_xml") {
  sources = [ "ukm/ukm.xml" ]
  outputs = [ "$root_out_dir/ukm.xml" ]
}

group("metrics_metadata") {
  deps = [
    ":actions_xml",
    ":ukm_xml",
  ]

  # Only include histograms_xml if we have access to dirmd data, which
  # is used to populate ownership information. This is disabled
  # for non-git checkouts, as dirmd doesn't work on non-git checkout.
  # TODO(crbug.com/329080012): Remove this condition once dirmd works
  # in non-git checkouts.
  if (path_exists("//.git")) {
    deps += [ ":histograms_xml" ]
  }
}

# This group defines the isolate files needed to run metrics_python_tests.py on
# bots. This also tells the build system when the tests should be re-run -
# when one of the dependent files changes.
#
# Every test file in the directories scanned by metrics_python_tests.py has to
# be listed below; tools/metrics/PRESUBMIT.py reports the missing ones.
#
# To run all the tests locally from src/:
#
#  vpython3 tools/metrics/metrics_python_tests.py
#
# To run the suite the way the bots do, use the UTR (tools/utr/README.md):
#
#  vpython3 tools/utr/run.py -B try -b linux-rel -t metrics_python_tests \
#    compile-and-test
#
group("metrics_python_tests") {
  data = [
    # The run_isolated_script_test.py script and its dependencies.

    # Scripts we depend on. Their unit tests are also included.

    # The metrics_python_tests.py runner and its dependencies.








  ]

  data += JSON_TO_STRUCT_FILES + JSON_TO_STRUCT_TEST_FILES

  # Add platform-specific dependencies for dirmd.
  if (is_win) {
    data += [
    ]
    if (host_os == "win") {
      data += [ "//third_party/depot_tools/.cipd_bin/dirmd.exe" ]
    }
  } else {
    data += [
    ]
    if (host_os != "win") {
      data += [ "//third_party/depot_tools/.cipd_bin/dirmd" ]
    }
  }

  data_deps = [ "//testing:test_scripts_shared" ]
}
